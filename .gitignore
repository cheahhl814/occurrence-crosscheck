# nested pixi envs are self-contained per sub-skill; keep out of the meta repo
crosscheck/.pixi/
viz/.pixi/
publish/.pixi/
# the router's own env (top-level pixi.toml) + its lockfile.
# Root-anchored: crosscheck/ and viz/ deliberately TRACK their pixi.lock
# (their envs are pinned and reproduced from the lock), so only the router's
# own lock is ignored.
.pixi/
/pixi.lock
*/__pycache__/
__pycache__/
*.pyc
work/
runs/
viz_out/
test/output/
docs-corpus/.fingerprints/
.env

# Preflight + battle-test session output (regenerated locally each run;
# contains personal-machine paths).
preflight.md
preflight_evidence.txt
battle-test-report*.md
debug-report*.md